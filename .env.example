# ===========================================================================
# Durgesh Flagship Portfolio - Environment Variables
# ===========================================================================

# --- Serverless Functions / Cloudflare Edge Environment ---
# Required: API key for Resend email dispatch (https://resend.com)
RESEND_API_KEY=re_your_api_key_here

# Optional: Contact form recipient address (defaults to durgeshdsinha@gmail.com)
CONTACT_TO_EMAIL=durgeshdsinha@gmail.com

# Optional: Contact form sender address
CONTACT_FROM_EMAIL=portfolio@durgesh.dev

# --- Client-Side Public Environment (Embedded at build-time) ---
# Optional: Display contact email
NEXT_PUBLIC_EMAIL=durgeshdsinha@gmail.com

# Optional: LinkedIn profile URL
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/durgesh-dutt-s-4ba74924b

# Optional: GitHub handle for API telemetry lookups
NEXT_PUBLIC_GITHUB_USERNAME=OxDurgeshxO

# Optional: Public phone number (leave unset for zero persistence)
NEXT_PUBLIC_PHONE=

# Base site URL for metadata and canonical tags
NEXT_PUBLIC_SITE_URL=https://durgesh-portfolio.pages.dev
